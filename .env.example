# Copy to .env.local and fill in. Never commit .env.local.

# --- Required ------------------------------------------------------------
# Postgres for the console and intake form. Use your own development database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buildautomation

# Signs JWT sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- Optional: sign-in ---------------------------------------------------
# Auth.js works this out from the request in development; set it when deployed.
# AUTH_URL=http://localhost:3000

# --- Optional: intake file uploads ---------------------------------------
# Without these, intake submissions that attach files (e.g. a logo) fail;
# submissions without files still work. Server-only values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTAKE_UPLOAD_BUCKET=

# --- Optional: one-click demo sites (agent/README.md, "One-click demo site")
# Turns the "Generate demo site" button on; each intake's demo is built in a
# subfolder here. Leave unset to hide the button.
# DEMO_SITES_DIR=/absolute/path/to/build-demo-sites
# Everything below has a default and only needs setting to change it.
# AGENT_PROVIDER=ollama                        # ollama (default), anthropic, or mock
# AGENT_LOCAL_MODEL_ID=qwen2.5:32b-instruct    # local model for ollama (default shown)
# ANTHROPIC_API_KEY=                           # required when AGENT_PROVIDER=anthropic
# AGENT_PYTHON=agent/.venv/bin/python          # Python that runs the agent (default shown)
# BUILD_TEMPLATE_SOURCE=../BUILD_TEMPLATE_REPO # template to clone, a path or git URL (default shown)
