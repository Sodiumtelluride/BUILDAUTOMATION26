# Copy to .env.local and use your own development database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buildautomation
# Generate a long random secret for JWT sessions (e.g. openssl rand -base64 32).
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Required only when submitting files. Keep these values server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTAKE_UPLOAD_BUCKET=

# Local demo builds (agent/README.md, "One-click demo site"). Leave unset to hide the Generate button.
# DEMO_SITES_DIR=/Users/you/build-demo-sites
# AGENT_PROVIDER=ollama              # switch to anthropic once ANTHROPIC_API_KEY is set
# ANTHROPIC_API_KEY=
