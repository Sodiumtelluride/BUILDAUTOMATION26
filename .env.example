# Copy to .env.local and use your own development database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buildautomation
# Generate a long random secret for JWT sessions (e.g. openssl rand -base64 32).
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Required only when submitting files. Keep these values server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTAKE_UPLOAD_BUCKET=

# Confirmation emails (Resend). Leave blank locally to skip sending; submissions still save.
# Keep RESEND_API_KEY server-only (Doppler in deployed environments).
RESEND_API_KEY=
# Sender on the verified domain, e.g. BUILD UMass <no-reply@buildumass.org>
INTAKE_EMAIL_FROM=
# Address shown to submitters for questions; also used as Reply-To.
INTAKE_SUPPORT_EMAIL=
